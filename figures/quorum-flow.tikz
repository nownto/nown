\begin{tikzpicture}[>=Latex,font=\footnotesize]
  % exits above the path
  \draw[muted,line width=0.5pt,dash pattern=on 2pt off 2.5pt,rounded corners=5pt] (0.30,3.05) rectangle (3.10,3.95);
  \node[muted,font=\scriptsize\itshape,align=center] at (1.70,3.50) {parties agree:\\ mutual close, no panel};
  \draw[muted,line width=0.5pt,dash pattern=on 1pt off 2pt,->] (1.05,2.35) -- (1.05,3.00);
  \draw[muted,line width=0.5pt,dash pattern=on 2pt off 2.5pt,rounded corners=5pt] (3.40,3.05) rectangle (6.10,3.95);
  \node[muted,font=\scriptsize\itshape,align=center] at (4.75,3.50) {call unanswered:\\ the timeout outcome};
  \draw[muted,line width=0.5pt,dash pattern=on 1pt off 2pt,->] (4.21,2.35) -- (4.21,3.00);
  % six stages
  \foreach \i/\x/\lab in {1/0.30/{\fontsize{6.5}{7.8}\selectfont dealing opens},2/1.88/{\fontsize{6.5}{7.8}\selectfont disagreement},3/3.46/{the call},6/8.20/{settlement}}{
    \draw[muted,line width=0.6pt,rounded corners=2pt] (\x,1.40) rectangle (\x+1.50,2.35);
    \node[bronze,font=\tiny\ttfamily,anchor=north west] at (\x+0.08,2.30) {\i};
    \node[ink,font=\scriptsize] at (\x+0.75,1.72) {\lab};
  }
  \foreach \i/\x/\laba/\labb in {4/5.04/evidence/window,5/6.62/secret/ballots}{
    \draw[muted,line width=0.6pt,rounded corners=2pt] (\x,1.40) rectangle (\x+1.50,2.35);
    \node[bronze,font=\tiny\ttfamily,anchor=north west] at (\x+0.08,2.30) {\i};
    \node[ink,font=\scriptsize,align=center] at (\x+0.75,1.72) {\laba\\[-1pt]\labb};
  }
  \foreach \x in {1.80,3.38,4.96,6.54,8.12}{
    \draw[muted,line width=0.8pt,->] (\x,1.875) -- (\x+0.08,1.875);
  }
  % the axis, block time at its beginning
  \node[muted,font=\footnotesize\itshape,anchor=west] at (0.30,1.05) {block time};
  \draw[muted,line width=0.9pt,->] (0.30,0.62) -- (9.85,0.62);
  \draw[muted,line width=0.5pt,dash pattern=on 1pt off 2pt] (6.54,1.40) -- (6.54,0.72);
  \draw[muted,line width=0.9pt] (6.54,0.72) -- (6.54,0.52);
  \node[bronze,font=\scriptsize\itshape] at (6.54,0.30) {close block};
  \draw[muted,line width=0.5pt,dash pattern=on 1pt off 2pt] (8.12,1.40) -- (8.12,0.72);
  \draw[muted,line width=0.9pt] (8.12,0.72) -- (8.12,0.52);
  \node[bronze,font=\scriptsize\itshape] at (8.12,0.30) {deadline};
\end{tikzpicture}
