\begin{tikzpicture}[>=Latex,font=\footnotesize,
  key/.style={draw=ink,text=ink,circle,line width=1pt,minimum size=0.5cm,inner sep=0pt,font=\footnotesize\ttfamily},
  keysm/.style={draw=ink,text=ink,circle,line width=0.9pt,minimum size=0.42cm,inner sep=0pt,font=\scriptsize\ttfamily}]
  \node[muted,font=\scriptsize\itshape] at (3.3,9.15) {every record is permanent};
  % the dealing
  \node[key] (A) at (2.4,8.5) {A};
  \node[key] (B) at (4.2,8.5) {B};
  \draw[muted,line width=0.8pt] (A) -- (B);
  \node[ink] at (3.3,7.9) {a dealing};
  \node[muted,font=\scriptsize\itshape,align=center] at (3.3,7.45) {two outcomes, the oracle, and\\ the quorum's moment, fixed at setup};
  % two modes
  \draw[muted,line width=0.8pt] (3.3,7.1) -- (3.3,6.9) -- (1.7,6.9);
  \draw[muted,line width=0.8pt,->] (1.7,6.9) -- (1.7,6.6);
  \draw[muted,line width=0.8pt] (3.3,6.9) -- (4.9,6.9);
  \draw[muted,line width=0.8pt,->] (4.9,6.9) -- (4.9,6.6);
  \node[ink] at (1.7,6.35) {parties only};
  \node[ink] at (4.9,6.35) {a quorum from the start};
  \draw[rulec,line width=0.5pt] (3.3,6.05) -- (3.3,1.35);
  % left: parties only
  \node[ink,font=\scriptsize] at (1.7,5.8) {both attest};
  \node[keysm] at (1.15,5.35) {A};
  \draw[bronze,line width=1.3pt,->] (1.55,5.18) -- (1.55,5.52);
  \node[keysm] at (2.05,5.35) {B};
  \draw[bronze,line width=1.3pt,->] (2.45,5.18) -- (2.45,5.52);
  \node[ink,font=\scriptsize,align=center] at (1.7,4.5) {or a quorum picks\\ one of the two:};
  \node[ink,font=\scriptsize,align=center] at (1.7,3.75) {one correct,\\ one incorrect};
  \node[keysm] at (1.15,3.15) {A};
  \draw[bronze,line width=1.3pt,->] (1.55,2.98) -- (1.55,3.32);
  \node[keysm] at (2.05,3.15) {B};
  \draw[muted,line width=1.3pt,->] (2.45,3.32) -- (2.45,2.98);
  % right: a quorum from the start
  \node[ink,font=\scriptsize] at (4.9,5.8) {the panel picks one:};
  \node[bronze,font=\scriptsize] at (4.9,5.5) {affirm: seal affixed};
  \node[keysm] at (4.35,5.05) {A};
  \draw[bronze,line width=1.3pt,->] (4.75,4.88) -- (4.75,5.22);
  \node[keysm] at (5.25,5.05) {B};
  \draw[bronze,line width=1.3pt,->] (5.65,4.88) -- (5.65,5.22);
  \node[bronze,font=\scriptsize] at (4.9,4.15) {deny: no seal,};
  \node[bronze,font=\scriptsize] at (4.9,3.8) {the issuer marked};
  \node[keysm] at (4.35,3.2) {A};
  \draw[muted,line width=1.3pt,->] (4.75,3.37) -- (4.75,3.03);
  \node[keysm] at (5.25,3.2) {B};
  \draw[muted,line width=1.3pt] (5.55,3.2) -- (5.75,3.2);
  % lapse
  \draw[rulec,line width=0.5pt] (0.1,1.05) -- (6.5,1.05);
  \node[muted,font=\scriptsize\itshape,align=center] at (3.3,0.7) {no one answers the call: the dealing falls to the\\ timeout outcome the parties fixed at creation};
  \node[muted,font=\scriptsize\itshape] at (3.3,0.1) {one mark to each key: up, or down};
\end{tikzpicture}
