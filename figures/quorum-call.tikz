\begin{tikzpicture}[>=Latex,font=\footnotesize]
  % who may sit, and who carries the call
  \draw[muted,line width=0.5pt,dash pattern=on 2pt off 2.5pt,rounded corners=5pt] (0.90,4.03) rectangle (3.94,4.81);
  \node[muted,font=\scriptsize\itshape,align=center] at (2.42,4.42) {keys above the bar,\\ each testing it privately};
  \draw[muted,line width=0.5pt,dash pattern=on 1pt off 2pt,->] (2.42,3.50) -- (2.42,3.98);
  \draw[muted,line width=0.5pt,dash pattern=on 2pt off 2.5pt,rounded corners=5pt] (4.24,4.03) rectangle (8.99,4.81);
  \node[muted,font=\scriptsize\itshape,align=center] at (6.62,4.42) {the call is carried by the clients,\\ and it names no party};
  \draw[muted,line width=0.5pt,dash pattern=on 1pt off 2pt,->] (4.70,3.50) -- (4.70,3.98);
  % five stages
  \foreach \i/\x/\lab in {1/1.68/{eligibility},2/3.40/{the call}}{
    \draw[muted,line width=0.6pt,rounded corners=2pt] (\x,2.55) rectangle (\x+1.47,3.50);
    \node[bronze,font=\tiny\ttfamily,anchor=north west] at (\x+0.08,3.45) {\i};
    \node[ink,font=\scriptsize] at (\x+0.735,2.87) {\lab};
  }
  \foreach \i/\x/\laba/\labb in {3/5.11/evidence/window,4/6.83/seats/signed,5/8.54/panel/minimum}{
    \draw[muted,line width=0.6pt,rounded corners=2pt] (\x,2.55) rectangle (\x+1.47,3.50);
    \node[bronze,font=\tiny\ttfamily,anchor=north west] at (\x+0.08,3.45) {\i};
    \node[ink,font=\scriptsize,align=center] at (\x+0.735,2.87) {\laba\\[-1pt]\labb};
  }
  \foreach \x in {3.20,4.91,6.63,8.34}{
    \draw[muted,line width=0.8pt,->] (\x,3.025) -- (\x+0.08,3.025);
  }
  % the axis, block time at its beginning
  \node[muted,font=\footnotesize\itshape,anchor=west] at (0.36,1.72) {block time};
  \draw[muted,line width=0.9pt,->] (0.36,1.42) -- (10.05,1.42);
  \foreach \x/\tk in {2.42/{opening block},4.14/{the call},5.85/{close tick},7.56/{?},9.28/{ballot clock}}{
    \draw[muted,line width=0.5pt,dash pattern=on 1pt off 2pt] (\x,2.55) -- (\x,1.51);
    \draw[muted,line width=0.9pt] (\x,1.51) -- (\x,1.33);
    \node[bronze,font=\scriptsize\itshape] at (\x,1.05) {\tk};
  }
  \node[muted,font=\scriptsize\itshape,align=center] at (5.11,0.28)
    {seats open at a block no one can predict\\
     each eligible key runs the case through a verifiable random function,\\
     qualifies below the threshold privately, and takes a seat by signing under bond};
\end{tikzpicture}
